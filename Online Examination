package com.exam.util;

import java.sql.Connection;
import java.sql.DriverManager;

public class DBConnection {
    // Port 3306 is the default MySQL port in XAMPP
    private static final String URL = "jdbc:mysql://localhost:3307/online_exam_db?useSSL=false&allowPublicKeyRetrieval=true";
    private static final String USER = "root";       
    private static final String PASS = "";           // Default XAMPP MySQL password is blank/empty

    public static Connection getConnection() {
        Connection con = null;
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            con = DriverManager.getConnection(URL, USER, PASS);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return con;
    }
}


